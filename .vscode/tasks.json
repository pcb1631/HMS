{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build main (GCC)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "main.c",
                "utils.c",
                "-o",
                "main.out",
                "-ansi",
                "-pedantic"
            ],
            "windows": {
                "args": [
                    "main.c",
                    "utils.c", 
                    "logins.c", 
                    "tui.c", 
                    "commands.c", 
                    "bookings.c", 
                    "deps/crypt_blowfish/wrapper.c", 
                    "deps/crypt_blowfish/crypt_blowfish.c", 
                    "deps/crypt_blowfish/crypt_gensalt.c", 
                    "-Ideps/crypt_blowfish", 
                    "-o", 
                    "main.exe", 
                    "-ansi", 
                    "-pedantic", 
                    "-Wextra",
                    "-Wall",
                    "-D_WIN32", 
                    "-lncurses", 
                    "-DNCURSES_STATIC", 
                    "-ladvapi32",
                    "-g"

                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
