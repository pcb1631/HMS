{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build main (GCC)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "main.c",
                "utils.c",
                "-o",
                "main.out",
                "-ansi",
                "-pedantic"
            ],
            "windows": {
                "args": [
                    "-g",
                    "main.c",
                    "utils.c",
                    "-o",
                    "main.exe",
                    "-ansi",
                    "-pedantic"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
