[
	{
		"label": "build and debug",
		"build": {
			"command": "make clean; make",
		},
		"program": "$ZED_WORKTREE_ROOT/main.out",
		"request": "launch",
		"adapter": "CodeLLDB",
		"env": {
			"TERM": "xterm-256color",
		},
	},
	{
		"label": "debug test.c",
		"build": {
			"command": "gcc test.c utils/tui.c utils/globals.c utils/utils.c utils/string_utils.c -ansi -lncurses -g",
		},
		"program": "$ZED_WORKTREE_ROOT/a.out",
		"request": "launch",
		"adapter": "CodeLLDB",
		"env": {
			"TERM": "xterm-256color",
		},
	},
	{
		"label": "debug filegen",
		"build": {
			"command": "gcc -o regen_file.out regen_file_structure.c utils/utils.c utils/string_utils.c -g -ansi"
		},
		"adapter": "CodeLLDB",
		"program": "$ZED_WORKTREE_ROOT/regen_file.out",
		"request": "launch",
	}
]
